{
  "name": "root",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Michał Korczak (https://omikor.in)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Omikorin/penpot-plugins.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build:pattern": "bun run --filter 'pattern-hero' build",
    "dev:pattern": "bun run --filter 'pattern-hero' dev",
    "install:pattern": "bun install --filter 'pattern-hero'",
    "build:qrcode": "bun run --filter 'beautiful-qrcode' build",
    "dev:qrcode": "bun run --filter 'beautiful-qrcode' dev",
    "install:qrcode": "bun install --filter 'beautiful-qrcode'",
    "build:waves": "bun run --filter 'waves-generator' build",
    "dev:waves": "bun run --filter 'waves-generator' dev",
    "install:waves": "bun install --filter 'waves-generator'",
    "format": "bun run --filter '*' format",
    "format:check": "bun run --filter '*' format:check",
    "lint": "bun run --filter '*' lint",
    "lint:check": "bun run --filter '*' lint:check",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "bun run lint:check && bun run format:check && bun run typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "packageManager": "bun@1.4.5",
  "catalog": {
    "@penpot/plugin-styles": "1.4.2",
    "@penpot/plugin-types": "1.4.2",
    "@solidjs/web": "^2.0.3",
    "@solidjs/vite-plugin": "^3.0.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "qr-code-styling": "^1.9.2",
    "solid-js": "^2.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
