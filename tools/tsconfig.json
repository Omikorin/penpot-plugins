{
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "../node_modules/.tmp/tools",
    "tsBuildInfoFile": "../node_modules/.tmp/tools/tsconfig.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true
  },
  "include": ["*.ts"]
}